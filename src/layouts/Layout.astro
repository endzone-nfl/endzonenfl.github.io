---
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/oswald/700.css';
import '../styles/global.css';
import { url } from '../lib/url.js';
import { site } from '../config.js';

const { title, eyebrow, heading, lead } = Astro.props;

const nav = [
  { href: '/regeln/', label: 'Regeln' },
  { href: '/positionen/', label: 'Positionen' },
  { href: '/schemes/', label: 'Schemes' },
  { href: '/playoff-picture/', label: 'Playoff Picture' },
];
const current = Astro.url.pathname;

const akzent = site.nameAkzent && site.name.endsWith(site.nameAkzent) ? site.nameAkzent : '';
const nameStart = akzent ? site.name.slice(0, -akzent.length) : site.name;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${site.name}` : `${site.name} – ${site.claim}`}</title>
    <meta
      name="description"
      content="NFL-Regeln, Positionen und Schemes auf Deutsch erklärt, dazu das aktuelle Playoff Picture."
    />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('/')}>{nameStart}{akzent && <span>{akzent}</span>}</a>
        <nav class="site-nav" aria-label="Hauptnavigation">
          {
            nav.map((item) => (
              <a href={url(item.href)} aria-current={current.endsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      {
        heading && (
          <div class="page-head">
            <div class="wrap">
              {eyebrow && <p class="eyebrow">{eyebrow}</p>}
              <h1>{heading}</h1>
              {lead && <p class="lead">{lead}</p>}
            </div>
          </div>
        )
      }
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        Private Fanseite, nicht mit der NFL oder ihren Teams verbunden. Tabellendaten: ESPN.
      </div>
    </footer>
  </body>
</html>
