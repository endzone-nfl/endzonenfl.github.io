---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url.js';
import standings from '../data/standings.json';
import champions from '../data/hall-of-fame.json';
import { regeln } from '../data/regeln.js';
import { positionen } from '../data/positionen.js';
import { schemes } from '../data/schemes.js';

const stand = new Date(standings.updated).toLocaleDateString('de-DE', {
  day: 'numeric',
  month: 'long',
  timeZone: 'Europe/Berlin',
});
const bilanz = (t) => `${t.wins}-${t.losses}${t.ties ? `-${t.ties}` : ''}`;
const letzter = [...champions].sort((a, b) => b.saison - a.saison)[0];

const bereiche = [
  { href: '/regeln/', titel: 'Regeln', text: 'Offside, Holding, Pass Interference: jede Flagge erklärt.', zahl: regeln.length },
  { href: '/positionen/', titel: 'Positionen', text: 'Vom Quarterback bis zum Long Snapper, mit Aufstellung.', zahl: positionen.length },
  { href: '/schemes/', titel: 'Schemes', text: 'Formationen, Offense-Systeme und Coverages.', zahl: schemes.length },
];
---

<Layout>
  <div class="hero">
    <div class="wrap">
      <p class="eyebrow">NFL &amp; Fantasy Football</p>
      <h1>Football verstehen.<br />Playoffs verfolgen.</h1>
      <p class="lead">
        Regeln, Positionen und Schemes auf Deutsch erklärt. Dazu das aktuelle Playoff Picture und die Champions
        unserer Fantasy-Liga.
      </p>
      <form class="suche" action={url('/regeln/')} method="get" role="search">
        <label for="start-suche">Regel nachschlagen</label>
        <div class="feld">
          <input id="start-suche" type="search" name="q" placeholder="z. B. Offside" autocomplete="off" />
          <button type="submit">Suchen</button>
        </div>
      </form>
    </div>
  </div>

  <div class="wrap">
    <section class="section">
      <h2>Nachschlagen</h2>
      <ul class="bereiche">
        {
          bereiche.map((b) => (
            <li>
              <a href={url(b.href)}>
                <span class="zahl">{b.zahl}</span>
                <span class="t">{b.titel}</span>
                <span class="muted">{b.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <div class="kopf">
        <h2>Playoff Picture</h2>
        <a class="mehr" href={url('/playoff-picture/')}>Alle 32 Teams</a>
      </div>
      <p class="muted">Diese Teams wären heute dabei. Stand: {stand}.</p>
      <div class="seeds">
        {
          standings.conferences.map((c) => (
            <div>
              <h3>{c.abbr}</h3>
              <ol>
                {c.teams
                  .filter((t) => t.seed <= 7)
                  .map((t) => (
                    <li class={t.seed === 1 ? 'eins' : undefined}>
                      <span class="s">{t.seed}</span>
                      <span class="n">{t.name}</span>
                      <span class="r">{bilanz(t)}</span>
                    </li>
                  ))}
              </ol>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="kopf">
        <h2>Hall of Fame</h2>
        <a class="mehr" href={url('/hall-of-fame/')}>Alle Champions</a>
      </div>
      {
        letzter ? (
          <p class="champ">
            <span class="badge red">Champion {letzter.saison}</span> <strong>{letzter.manager}</strong>
            {letzter.team && <span class="muted"> · {letzter.team}</span>}
          </p>
        ) : (
          <p class="muted">Die Champions unserer Fantasy-Liga werden hier bald verewigt.</p>
        )
      }
    </section>
  </div>
</Layout>

<style>
  .hero {
    background:
      repeating-linear-gradient(90deg, transparent 0 4.9rem, rgb(255 255 255 / 0.07) 4.9rem 5rem),
      linear-gradient(180deg, var(--navy), var(--bg));
    padding-block: 3.5rem 3rem;
  }
  .eyebrow {
    font-family: var(--font-display);
    color: var(--red-soft);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .lead {
    color: var(--muted);
    max-width: 38rem;
    margin-top: 1rem;
    font-size: 1.1rem;
  }
  .suche {
    margin-top: 1.75rem;
    max-width: 30rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
  }
  .suche label {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .feld {
    display: flex;
    gap: 0.5rem;
    min-width: 0;
  }
  .feld input {
    flex: 1;
    min-width: 0;
    font: inherit;
    padding: 0.7rem 0.9rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .feld button {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--red);
    border: 0;
    border-radius: 6px;
    padding: 0 1.2rem;
    cursor: pointer;
  }
  .feld button:hover {
    background: color-mix(in srgb, var(--red) 85%, white);
  }
  .bereiche {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
  }
  .bereiche a {
    display: grid;
    gap: 0.2rem;
    height: 100%;
    align-content: start;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.1rem 1.2rem 1.3rem;
  }
  .bereiche a:hover {
    border-color: var(--red-soft);
  }
  .zahl {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1;
    color: var(--red-soft);
  }
  .t {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    text-transform: uppercase;
  }
  .kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
    margin-bottom: 0.4rem;
  }
  .mehr {
    color: var(--red-soft);
    font-size: 0.95rem;
  }
  .seeds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem 2rem;
    margin-top: 1rem;
  }
  .seeds h3 {
    border-bottom: 3px solid var(--red);
    padding-bottom: 0.3rem;
  }
  .seeds ol {
    list-style: none;
    margin: 0;
    padding: 0;
    font-variant-numeric: tabular-nums;
  }
  .seeds li {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.4rem 0.2rem;
    border-bottom: 1px solid var(--line);
  }
  .seeds .s {
    font-family: var(--font-display);
    font-weight: 600;
    width: 1.2rem;
    text-align: center;
    color: var(--muted);
  }
  .seeds .eins .s {
    color: var(--gold);
  }
  .seeds .n {
    flex: 1;
    min-width: 0;
  }
  .seeds .r {
    font-weight: 600;
  }
  .champ {
    font-size: 1.1rem;
  }
</style>
