---
import Layout from '../layouts/Layout.astro';
import eintraege from '../data/hall-of-fame.json';

// Felder pro Eintrag in src/data/hall-of-fame.json:
// { "saison": 2024, "manager": "Name", "team": "Teamname", "bilanz": "10-4",
//   "finale": "132,4 : 118,9 gegen …", "notiz": "freier Text" }
// Pflicht sind nur saison und manager.
const sieger = [...eintraege].sort((a, b) => b.saison - a.saison);

const titel = Object.entries(
  sieger.reduce((acc, e) => {
    (acc[e.manager] ??= []).push(e.saison);
    return acc;
  }, {}),
)
  .map(([manager, jahre]) => ({ manager, jahre: jahre.sort((a, b) => a - b) }))
  .sort((a, b) => b.jahre.length - a.jahre.length || b.jahre.at(-1) - a.jahre.at(-1));
---

<Layout
  title="Hall of Fame"
  eyebrow="Fantasy Football"
  heading="Hall of Fame"
  lead="Alle Champions unserer Fantasy-Liga. Wer hier steht, hat eine Saison lang alles richtig gemacht."
>
  <div class="wrap">
    {
      sieger.length === 0 ? (
        <div class="leer">
          <svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
            <path
              d="M20 8h24v14a12 12 0 0 1-24 0V8zM20 12H10v4a8 8 0 0 0 10 7.7M44 12h10v4a8 8 0 0 1-10 7.7M32 34v10M22 54h20M26 44h12v10H26z"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linejoin="round"
              stroke-linecap="round"
            />
          </svg>
          <h2>Noch keine Champions eingetragen</h2>
          <p class="muted">Sobald die Sieger der bisherigen Saisons feststehen, erscheinen sie hier.</p>
        </div>
      ) : (
        <>
          <section class="section">
            <h2>Champions</h2>
            <ol class="banner">
              {sieger.map((e) => (
                <li>
                  <p class="jahr">{e.saison}</p>
                  <p class="manager">{e.manager}</p>
                  {e.team && <p class="team">{e.team}</p>}
                  <dl>
                    {e.bilanz && (
                      <div>
                        <dt>Bilanz</dt>
                        <dd>{e.bilanz}</dd>
                      </div>
                    )}
                    {e.finale && (
                      <div>
                        <dt>Finale</dt>
                        <dd>{e.finale}</dd>
                      </div>
                    )}
                  </dl>
                  {e.notiz && <p class="notiz muted">{e.notiz}</p>}
                </li>
              ))}
            </ol>
          </section>

          <section class="section">
            <h2>Meiste Titel</h2>
            <ol class="rang">
              {titel.map((t) => (
                <li>
                  <span class="anzahl">{t.jahre.length}×</span>
                  <span class="wer">{t.manager}</span>
                  <span class="muted">{t.jahre.join(', ')}</span>
                </li>
              ))}
            </ol>
          </section>
        </>
      )
    }
  </div>
</Layout>

<style>
  .leer {
    margin-top: 2.5rem;
    border: 1px dashed var(--line);
    border-radius: 10px;
    padding: 3rem 1.5rem;
    display: grid;
    gap: 0.8rem;
    justify-items: center;
    text-align: center;
    color: var(--gold);
  }
  .leer h2 {
    color: var(--text);
  }
  .banner {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
  }
  .banner li {
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--line);
    border-top: 4px solid var(--gold);
    border-radius: 0 0 8px 8px;
    padding: 1rem 1.1rem 1.2rem;
    display: grid;
    gap: 0.3rem;
    align-content: start;
    min-width: 0;
  }
  .jahr {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }
  .manager {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .team {
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  dl {
    margin: 0.5rem 0 0;
    display: grid;
    gap: 0.25rem;
    font-size: 0.9rem;
  }
  dl div {
    display: flex;
    gap: 0.6rem;
  }
  dt {
    font-family: var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    min-width: 3.6rem;
  }
  dd {
    margin: 0;
  }
  .notiz {
    font-size: 0.9rem;
    margin-top: 0.4rem;
  }
  .rang {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 32rem;
  }
  .rang li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.8rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
  }
  .anzahl {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--gold);
    min-width: 2.5rem;
  }
  .wer {
    font-weight: 600;
  }
</style>
